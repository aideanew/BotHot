{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // @bothot/contracts 为纯类型消费（全部 import type，编译期擦除）：由 paths 解析
    // ../../packages/contracts/src，非 npm 依赖——仓库无 pnpm workspace 根，package.json
    // 里出现 workspace:* 会让 frozen install 必红（2026-09-30 CI 实测）。
    "paths": { "@/*": ["./*"], "@bothot/contracts": ["../../packages/contracts/src/index"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
