{
  "name": "bothot-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "prebuild": "node -e \"if (process.env.NEXT_PUBLIC_API_MOCK !== 'false') { console.error('Error: NEXT_PUBLIC_API_MOCK must be explicitly set to false in production (NEXT_PUBLIC_API_MOCK=false)'); process.exit(1) }\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "ci:repro": "bash scripts/ci-repro-frontend.sh"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rolldown/binding-wasm32-wasi": "^1.2.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "happy-dom": "^15.11.7",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
