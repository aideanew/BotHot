# ============================================================
# BotHot 环境变量模板（复制为 .env 后填写，.env 已被 gitignore）
# 安全铁律：真实密钥禁止入库/入文档/入前端
# ============================================================

# ---- 构建（基础镜像镜像源）----
# 默认走 docker.io；Docker 无法直连 docker.io 时改成镜像源（实证可用）：
#   BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim     # backend/migrate/scheduler/worker
#   frontend 单独构建时用 node 镜像（compose 已按服务区分默认值）
# 更通用的替代：给 Docker daemon 配 registry-mirrors（对本仓库与所有镜像同时生效）。

# ---- 数据库 ----
# ADR-0010：compose.yml 的 backend/migrate/scheduler/worker 读 ${DATABASE_URL:?}/${REDIS_URL:?}，
# 两者缺失时 `docker compose config` 直接报错（设计如此，避免静默连到错误的库）。
# 真实口令禁止写入本文件与本仓库任何文件——只写入 docker/.env（已 gitignore）。
#
# ⚠️ 自本改动起，本文件的 DATABASE_URL/REDIS_URL **会被 compose 真正读取**（此前 compose
#    里是硬编码字面量，本文件同名键是惰性的）。所以 `cp docker/.env.example docker/.env`
#    之后必须把这两行改成与你的底座形态一致的值，否则容器会连到一个不存在的 host。
#
# 形态 A｜共享底座 = 本仓库当前实际部署形态（compose.yml:45-47 说明 postgres/redis 已从
#   栈中移除，由外部 shared-infra 提供；容器经 host.docker.internal 访问宿主端口）。
#   下面两行即按形态 A 给出，口令留空待填。
# 形态 B｜栈内底座（自行在同一栈起 postgres/redis，服务名即主机名）：
#   DATABASE_URL=postgresql+psycopg://bothot:<你的口令>@postgres:5432/bothot
#   REDIS_URL=redis://redis:6379/1
DATABASE_URL=postgresql+psycopg://<底座账号>:<口令从运维工单获取>@host.docker.internal:5435/bothot

# ---- Redis ----
REDIS_URL=redis://host.docker.internal:6379/1
# 以下三键主 compose.yml **不引用**（compose.ci.yml 里用的是硬编码字面量，也不读本文件）；
# 仅当你在本地自行加一个 postgres 服务时才用得到。保留是为了那条路径可照抄。
POSTGRES_USER=bothot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bothot
# T1.5.1（G9）：会话/state 存储后端（memory|redis）；容器部署默认 redis，宿主裸跑可不设（回落 memory）
SESSION_STORE_BACKEND=redis

# ---- Aidean 主平台（SSO IdP / 钱包 / 计费网关）----
# 主平台对外地址（生产由 NEXT_PUBLIC_SITE_URL 决定）
# A-T21 裁决B实施（2026-09-11）：双变量拆分——
#   AIDEAN_PUBLIC_URL = 浏览器侧 authorize 302 基址（须浏览器可达，本地取 localhost:3000）；
#   AIDEAN_ISSUER     = 容器侧 token/userinfo/wallet 基址（须容器可达宿主，取 host.docker.internal:3000）。
#   backend 空串回落 issuer（单值语义，生产零变更）；禁再手工注入单值 env 冒充修复。
AIDEAN_ISSUER=http://host.docker.internal:3000
AIDEAN_PUBLIC_URL=http://localhost:3000
OIDC_CLIENT_ID=wechat-rag
# A-T18: SSO redirect_uri must hit Host-DB whitelist (oidc_clients.redirect_uris[1])
# 该值只影响 redirect_uri（非 issuer），与上面的双消费方冲突无关，浏览器/容器两侧一致。
OIDC_REDIRECT_URI=http://localhost:3200/auth/aidean/callback
# 与主平台侧 OIDC_CLIENT_SECRET_WECHAT_RAG 一致，由管理员下发
OIDC_CLIENT_SECRET=change-me
# R5.1.1：userinfo 的 iss/aud 期望值（生产必填，见 production_guard_violations）。
# 注意 OIDC_ISSUER_EXPECTED 取**令牌里的 iss 值**（= 主平台 NEXT_PUBLIC_SITE_URL，
# 即 http://localhost:3000），**不是**容器内网基址 AIDEAN_ISSUER——两者语义不同，
# 混填会导致 userinfo / logout_token 全部校验失败。
OIDC_ISSUER_EXPECTED=http://localhost:3000
OIDC_AUDIENCE_EXPECTED=wechat-rag
# R9 back-channel logout：logout_token 的 |now - iat| 有界窗（秒）。
# 主平台签发的 logout_token **不含 exp**，必须自建时间窗；取 300 对齐主平台
# JWKS 的 cache-control max-age=300。
OIDC_LOGOUT_TOKEN_MAX_AGE_SECONDS=300
# R9：须由主平台管理员在 oidc_clients 表为本 client 写入 logoutUri 才会投递，
# 本方端点为 https://<二级域名>/api/v1/auth/backchannel-logout（经前端同源代理
# POST 转发，next.config.mjs 的 rewrite 无方法限定）。未登记时本方端点静默闲置，
# 会话随 refresh 轮换失败自然失效（降级路径安全，指南 v1.3 §4 末句）。
# 统一计费网关（OpenAI 兼容，LangBot Provider 指向此处）
AIDEAN_GATEWAY_URL=http://localhost:3000/api/v1/gateway/chat

# ---- LangBot（机器人运行时 / RAG 引擎）----
LANGBOT_BASE_URL=http://langbot:5300
# LangBot Web 管理端签发的 API Key（lbk_ 前缀）
LANGBOT_API_KEY=change-me
# HTTP Bot 适配器的入站签名密钥（inbound_secret）
LANGBOT_HTTPBOT_SECRET=change-me
# 已创建的 HTTP Bot uuid（T0.4 实证后填写）
LANGBOT_HTTPBOT_UUID=change-me

# ---- Redfox（公众号 Discovery Provider）----
REDFOX_BASE_URL=https://redfox.hk
REDFOX_API_KEY=change-me

# ---- 嵌入服务（API 形态，本地不部署大模型——ADR-0002 增补三）----
# 默认推荐硅基流动（国内直连、OpenAI 兼容、bge 系列低价）；可换任意 OpenAI 兼容端点
# LangBot 侧同配置注册为 provider + embedding model（M1 T1.0.1）
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 网络代理（分层规范：镜像为主、代理为辅）----
# 国外运行时访问（OpenAI 类 API、市场插件包下载）经宿主 10808（实测 HTTP/SOCKS5 双协议）
# 依赖安装不走代理（走国内镜像，见 compose 的 LANGBOT_PLUGIN_PYPI_INDEX_URL）
# 国内服务（主平台/redfox/硅基流动）直连，由 compose 的 NO_PROXY 白名单排除
# 注意：Docker Desktop 会注入宿主代理 env（10809 已失效），compose 已显式覆盖
PROXY_HTTP=http://host.docker.internal:10808

# ---- 应用 ----
APP_ENV=development
APP_SECRET_KEY=change-me

# ---- 渠道/引擎密钥主密钥（AES-256-GCM，32 字节 base64；缺失即 fail-closed 拒启）----
# 两者分属不同泄露域、不同轮换周期，禁止复用同一值（README「部署指南」有完整说明）
PUSH_SECRET_MASTER_KEY=change-me-base64-32bytes
ENGINE_KEY_MASTER_KEY=change-me-base64-32bytes

# ---- 运行期告警（R1.3；STEP-16/V0.7.0 起部署层默认开启）----
# 代码层默认 false（开发/测试零副作用，见 apps/api/tests/test_alerting_drill.py:139），
# 这里写 true 是为了让"生产默认在探测"成为显式事实而不是口头约定。
# 关掉它的唯一正当理由：你已有外部告警通道，且能接受仓内三类探测器不再产生第二条信号。
ALERTING_ENABLED=true
# 心跳告警启动宽限（秒）：滚动发布后新进程未写首拍心跳的窗口内不报 stale。
# 0 = 不宽限（代码默认值）；部署建议 600，避免每次发版误报刷屏后被人整个关掉。
ALERT_STARTUP_GRACE_SECONDS=600
# 同一告警的冷却窗口（秒）：探测每 60s 跑一次，无冷却会让一条持续积压每分钟投一条通知。
# 0 = 不冷却（代码默认值）；部署建议 1800，让"开着告警"不等于"把自己告到关为止"。
ALERT_COOLDOWN_SECONDS=1800
# 告警投递渠道：feishu | dingtalk | wechat_work | webhook | web（须已配置对应渠道）
ALERT_CHANNEL=web
# 渠道目标（webhook URL / 会话标识等，按所选渠道语义填写）
ALERT_TARGET=
# 告警阈值（可选，默认即代码默认值）
# 推送连败判定窗口（最近 N 条全部非 success 即告警）
ALERT_PUSH_FAIL_WINDOW=5
# Job 积压阈值（QUEUED 超过该数即告警）
ALERT_JOB_BACKLOG=100

# 推送调度器轮询间隔（秒，可选；默认 60，下限 5。一般无需设置——
# 调大仅降低事件推送实时性，调小徒增 SKIP LOCKED 锁竞争）
# PUSH_SCHEDULER_INTERVAL=60
